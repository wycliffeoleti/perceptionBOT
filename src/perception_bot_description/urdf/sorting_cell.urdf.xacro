<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sorting_cell">

  <!-- FR3 arm mounted on the table -->
  <xacro:include filename="$(find franka_description)/robots/fr3/fr3.urdf.xacro"/>

  <!-- Args forwarded to franka xacro -->
  <xacro:arg name="hand"             default="true"/>
  <xacro:arg name="gazebo"           default="true"/>
  <xacro:arg name="gazebo_effort"    default="false"/>
  <xacro:arg name="ros2_control"     default="true"/>
  <xacro:arg name="use_fake_hardware" default="false"/>

  <!-- World link (Gazebo requires a world/base link) -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child  link="fr3_link0"/>
    <origin xyz="0 0 0.81" rpy="0 0 0"/>
    <!-- 0.81m = table height: arm base sits on the table surface -->
  </joint>

  <!-- Table -->
  <link name="table">
    <visual>
      <geometry><box size="1.2 0.8 0.81"/></geometry>
      <material name="table_wood">
        <color rgba="0.72 0.55 0.38 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="1.2 0.8 0.81"/></geometry>
    </collision>
    <inertial>
      <mass value="40.0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>

  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child  link="table"/>
    <origin xyz="0.4 0 0.405" rpy="0 0 0"/>
  </joint>

  <!-- Eye-to-hand camera above the workspace -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.09 0.025"/></geometry>
      <material name="cam_body">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.05 0.09 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="world_to_camera" type="fixed">
    <parent link="world"/>
    <child  link="camera_link"/>
    <!-- 1.5m above table surface, angled 45° downward, looking at workspace center -->
    <origin xyz="-0.2 0 1.5" rpy="0 0.785 0"/>
  </joint>

  <!-- Camera optical frame (z-forward, x-right, y-down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Gazebo camera sensor plugin -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>10.0</far></clip>
      </camera>
      <plugin
        filename="gz-sim-ros-camera-system"
        name="gz_ros2_control::CameraPlugin">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <ros>
          <remapping>~/image_raw:=/camera/image_raw</remapping>
          <remapping>~/camera_info:=/camera/camera_info</remapping>
        </ros>
      </plugin>
    </sensor>

    <!-- Depth camera (Gazebo ground truth depth) -->
    <sensor name="depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip><near>0.05</near><far>10.0</far></clip>
      </camera>
      <plugin
        filename="gz-sim-ros-depth-camera-system"
        name="gz_ros2_control::DepthCameraPlugin">
        <camera_name>depth_camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <ros>
          <remapping>~/image_raw:=/camera/depth</remapping>
          <remapping>~/points:=/camera/points</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
